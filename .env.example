NODE_ENV=development
PORT=3100
HOST=0.0.0.0
API_PREFIX=api
CORS_ORIGINS=http://localhost:5666,http://localhost:5555
DATABASE_URL=postgresql://stonelab:stonelab@localhost:5432/stonelab?schema=public
REDIS_URL=redis://127.0.0.1:6379
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-another-32-random-characters
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
ADMIN_INITIAL_USERNAME=admin
ADMIN_INITIAL_PASSWORD=123456
ADMIN_INITIAL_NAME=StoneLab 管理员

# Alibaba Cloud OSS
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET=stonelab-assets
OSS_REGION=oss-cn-wuhan-lr
OSS_ENDPOINT=https://oss-cn-wuhan-lr.aliyuncs.com
OSS_SIGNED_URL_EXPIRES_SECONDS=3600

# Legacy bead catalog used by the one-off asset migration script
OLD_BEAD_API_BASE=https://chuming.rwacn.net/index.php/api/custom.bead
OLD_BEAD_API_TOKEN=
OLD_BEAD_API_APP_ID=10001
