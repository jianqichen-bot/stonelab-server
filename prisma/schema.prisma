generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum RecordStatus {
  ENABLED
  DISABLED
}

enum InventoryChangeType {
  INITIAL
  PURCHASE
  SALE
  ADJUSTMENT
  RETURN
}

enum BeadShape {
  ROUND
  CUBE
  CHARM
  CHIP
}

model AdminUser {
  id           String       @id @default(cuid())
  username     String       @unique @db.VarChar(64)
  passwordHash String       @map("password_hash") @db.VarChar(255)
  realName     String       @map("real_name") @db.VarChar(100)
  roles        String[]     @default(["admin"])
  permissions  String[]     @default([])
  status       RecordStatus @default(ENABLED)
  lastLoginAt  DateTime?    @map("last_login_at")
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  @@map("admin_users")
}

model Category {
  id        Int           @id @default(autoincrement())
  parentId  Int?          @map("parent_id")
  name      String        @db.VarChar(100)
  slug      String        @unique @db.VarChar(100)
  sort      Int           @default(0)
  status    RecordStatus  @default(ENABLED)
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")
  parent    Category?     @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children  Category[]    @relation("CategoryTree")
  products  BeadProduct[]

  @@index([parentId, sort])
  @@map("categories")
}

model BeadProduct {
  id           Int           @id @default(autoincrement())
  categoryId   Int           @map("category_id")
  name         String        @db.VarChar(120)
  slug         String        @unique @db.VarChar(140)
  mineralType  String?       @map("mineral_type") @db.VarChar(80)
  color        String?       @db.VarChar(80)
  origin       String?       @db.VarChar(120)
  shortMeaning String?       @map("short_meaning") @db.VarChar(255)
  description  String?       @db.Text
  imageKey     String?       @map("image_key") @db.VarChar(500)
  shape        BeadShape     @default(ROUND)
  sort         Int           @default(0)
  status       RecordStatus  @default(ENABLED)
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")
  category     Category      @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  variants     BeadVariant[]

  @@index([categoryId, status, sort])
  @@map("bead_products")
}

model BeadVariant {
  id                Int               @id @default(autoincrement())
  productId         Int               @map("product_id")
  sku               String            @unique @db.VarChar(64)
  label             String            @db.VarChar(100)
  diameterMm        Decimal?          @map("diameter_mm") @db.Decimal(6, 2)
  unitPriceCents    Int               @map("unit_price_cents")
  stock             Int               @default(0)
  lowStockThreshold Int               @default(5) @map("low_stock_threshold")
  status            RecordStatus      @default(ENABLED)
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")
  product           BeadProduct       @relation(fields: [productId], references: [id], onDelete: Cascade)
  inventoryRecords  InventoryRecord[]

  @@index([productId, status])
  @@map("bead_variants")
}

model InventoryRecord {
  id          BigInt              @id @default(autoincrement())
  variantId   Int                 @map("variant_id")
  change      Int
  stockBefore Int                 @map("stock_before")
  stockAfter  Int                 @map("stock_after")
  type        InventoryChangeType
  remark      String?             @db.VarChar(255)
  operatorId  String?             @map("operator_id") @db.VarChar(64)
  createdAt   DateTime            @default(now()) @map("created_at")
  variant     BeadVariant         @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([variantId, createdAt])
  @@map("inventory_records")
}
