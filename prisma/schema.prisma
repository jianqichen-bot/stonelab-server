generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum RecordStatus {
  ENABLED
  DISABLED
}

enum InventoryChangeType {
  INITIAL
  PURCHASE
  SALE
  ADJUSTMENT
  RETURN
}

enum BeadShape {
  ROUND
  CUBE
  CHARM
  CHIP
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  PROCESSING
  SHIPPED
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PAID
  REFUNDED
}

model AdminUser {
  id                String           @id @default(cuid())
  username          String           @unique @db.VarChar(64)
  passwordHash      String           @map("password_hash") @db.VarChar(255)
  realName          String           @map("real_name") @db.VarChar(100)
  phone             String?          @db.VarChar(20)
  email             String?          @db.VarChar(100)
  avatarKey         String?          @map("avatar_key") @db.VarChar(255)
  departmentId      Int?             @map("department_id")
  legacyRoles       String[]         @default([]) @map("roles")
  legacyPermissions String[]         @default([]) @map("permissions")
  status            RecordStatus     @default(ENABLED)
  lastLoginAt       DateTime?        @map("last_login_at")
  createdAt         DateTime         @default(now()) @map("created_at")
  updatedAt         DateTime         @updatedAt @map("updated_at")
  department        AdminDepartment? @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  roleRecords       AdminRole[]

  @@index([departmentId])
  @@map("admin_users")
}

model AdminDepartment {
  id        Int               @id @default(autoincrement())
  parentId  Int?              @map("parent_id")
  name      String            @db.VarChar(50)
  sort      Int               @default(0)
  status    RecordStatus      @default(ENABLED)
  remark    String            @default("") @db.VarChar(255)
  createdAt DateTime          @default(now()) @map("created_at")
  updatedAt DateTime          @updatedAt @map("updated_at")
  parent    AdminDepartment?  @relation("AdminDepartmentTree", fields: [parentId], references: [id], onDelete: Restrict)
  children  AdminDepartment[] @relation("AdminDepartmentTree")
  users     AdminUser[]

  @@index([parentId, sort])
  @@map("admin_departments")
}

model AdminMenu {
  id         Int          @id @default(autoincrement())
  parentId   Int?         @map("parent_id")
  name       String       @db.VarChar(50)
  nameEn     String       @default("") @map("name_en") @db.VarChar(100)
  type       String       @db.VarChar(16)
  path       String       @default("") @db.VarChar(255)
  component  String       @default("") @db.VarChar(255)
  permission String       @default("") @db.VarChar(100)
  icon       String       @default("") @db.VarChar(100)
  sort       Int          @default(0)
  status     RecordStatus @default(ENABLED)
  createdAt  DateTime     @default(now()) @map("created_at")
  updatedAt  DateTime     @updatedAt @map("updated_at")
  parent     AdminMenu?   @relation("AdminMenuTree", fields: [parentId], references: [id], onDelete: Restrict)
  children   AdminMenu[]  @relation("AdminMenuTree")
  roles      AdminRole[]

  @@index([parentId, sort])
  @@index([permission])
  @@map("admin_menus")
}

model AdminRole {
  id        Int          @id @default(autoincrement())
  code      String       @unique @db.VarChar(50)
  name      String       @unique @db.VarChar(50)
  status    RecordStatus @default(ENABLED)
  remark    String       @default("") @db.VarChar(255)
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")
  menus     AdminMenu[]
  users     AdminUser[]

  @@map("admin_roles")
}

model Category {
  id        Int           @id @default(autoincrement())
  parentId  Int?          @map("parent_id")
  name      String        @db.VarChar(100)
  slug      String        @unique @db.VarChar(100)
  sort      Int           @default(0)
  status    RecordStatus  @default(ENABLED)
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")
  parent    Category?     @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children  Category[]    @relation("CategoryTree")
  products  BeadProduct[]

  @@index([parentId, sort])
  @@map("categories")
}

model BeadProduct {
  id           Int           @id @default(autoincrement())
  categoryId   Int           @map("category_id")
  name         String        @db.VarChar(120)
  slug         String        @unique @db.VarChar(140)
  mineralType  String?       @map("mineral_type") @db.VarChar(80)
  color        String?       @db.VarChar(80)
  origin       String?       @db.VarChar(120)
  shortMeaning String?       @map("short_meaning") @db.VarChar(255)
  description  String?       @db.Text
  imageKey     String?       @map("image_key") @db.VarChar(500)
  shape        BeadShape     @default(ROUND)
  sort         Int           @default(0)
  status       RecordStatus  @default(ENABLED)
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")
  category     Category      @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  variants     BeadVariant[]
  orderItems   OrderItem[]

  @@index([categoryId, status, sort])
  @@map("bead_products")
}

model BeadVariant {
  id                Int               @id @default(autoincrement())
  productId         Int               @map("product_id")
  sku               String            @unique @db.VarChar(64)
  label             String            @db.VarChar(100)
  diameterMm        Decimal?          @map("diameter_mm") @db.Decimal(6, 2)
  unitPriceCents    Int               @map("unit_price_cents")
  stock             Int               @default(0)
  lowStockThreshold Int               @default(5) @map("low_stock_threshold")
  status            RecordStatus      @default(ENABLED)
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")
  product           BeadProduct       @relation(fields: [productId], references: [id], onDelete: Cascade)
  inventoryRecords  InventoryRecord[]
  orderItems        OrderItem[]

  @@index([productId, status])
  @@map("bead_variants")
}

model InventoryRecord {
  id          BigInt              @id @default(autoincrement())
  variantId   Int                 @map("variant_id")
  change      Int
  stockBefore Int                 @map("stock_before")
  stockAfter  Int                 @map("stock_after")
  type        InventoryChangeType
  remark      String?             @db.VarChar(255)
  operatorId  String?             @map("operator_id") @db.VarChar(64)
  createdAt   DateTime            @default(now()) @map("created_at")
  variant     BeadVariant         @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([variantId, createdAt])
  @@map("inventory_records")
}

model Order {
  id                String        @id @default(cuid())
  orderNo           String        @unique @map("order_no") @db.VarChar(32)
  customerId        String?       @map("customer_id") @db.VarChar(64)
  recipientName     String        @map("recipient_name") @db.VarChar(50)
  recipientPhone    String        @map("recipient_phone") @db.VarChar(20)
  recipientProvince String        @map("recipient_province") @db.VarChar(50)
  recipientCity     String        @map("recipient_city") @db.VarChar(50)
  recipientDistrict String        @map("recipient_district") @db.VarChar(50)
  recipientAddress  String        @map("recipient_address") @db.VarChar(255)
  subtotalCents     Int           @map("subtotal_cents")
  shippingFeeCents  Int           @default(0) @map("shipping_fee_cents")
  totalAmountCents  Int           @map("total_amount_cents")
  status            OrderStatus   @default(PENDING_PAYMENT)
  paymentStatus     PaymentStatus @default(UNPAID) @map("payment_status")
  buyerRemark       String        @default("") @map("buyer_remark") @db.VarChar(500)
  adminRemark       String        @default("") @map("admin_remark") @db.VarChar(500)
  trackingCompany   String        @default("") @map("tracking_company") @db.VarChar(100)
  trackingNo        String        @default("") @map("tracking_no") @db.VarChar(100)
  paidAt            DateTime?     @map("paid_at")
  shippedAt         DateTime?     @map("shipped_at")
  completedAt       DateTime?     @map("completed_at")
  cancelledAt       DateTime?     @map("cancelled_at")
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")
  items             OrderItem[]

  @@index([status, createdAt])
  @@index([customerId, createdAt])
  @@index([recipientPhone])
  @@map("orders")
}

model OrderItem {
  id              BigInt       @id @default(autoincrement())
  orderId         String       @map("order_id")
  productId       Int?         @map("product_id")
  variantId       Int?         @map("variant_id")
  productName     String       @map("product_name") @db.VarChar(120)
  variantName     String       @map("variant_name") @db.VarChar(100)
  imageKey        String?      @map("image_key") @db.VarChar(500)
  diameterMm      Decimal?     @map("diameter_mm") @db.Decimal(6, 2)
  unitPriceCents  Int          @map("unit_price_cents")
  quantity        Int
  totalPriceCents Int          @map("total_price_cents")
  position        Int          @default(0)
  createdAt       DateTime     @default(now()) @map("created_at")
  order           Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product         BeadProduct? @relation(fields: [productId], references: [id], onDelete: SetNull)
  variant         BeadVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([orderId, position])
  @@index([productId])
  @@index([variantId])
  @@map("order_items")
}
